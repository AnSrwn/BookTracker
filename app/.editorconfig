root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# Composables are named like types (BookshelfScreen), as Compose expects
ktlint_function_naming_ignore_when_annotated_with = Composable

[*Contract.kt]
# A screen's contract file is named after the screen (D52), not after its single type
ktlint_standard_filename = disabled

[*.{yml,yaml,json,xcstrings}]
indent_size = 2
