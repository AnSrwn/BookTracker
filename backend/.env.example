# Copy to .env and adjust. Used by compose.prod.yaml.
DATABASE=database_TBD
DB_USERNAME=username_TBD
DB_PASSWORD=password_TBD
APP_PORT=8080

# Keycloak realm URL. Keycloak itself is not part of compose.prod.yaml yet.
# Use a stable DNS name: changing it invalidates every issued token.
BOOKTRACKER_ISSUER_URI=https://auth.example.com/realms/booktracker

# Contact for Open Library's API policy: lets them reach us instead of blocking us
BOOKTRACKER_BOOKDATA_USER_AGENT="BookTracker/0.1 (you@example.org)"
