{
  "realm": "booktracker",
  "enabled": true,
  "displayName": "BookTracker",
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard BookTracker user"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-booktracker",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "user"
          ],
          "client": {
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        },
        "clientRole": false,
        "containerId": "booktracker"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-booktracker",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "booktracker"
  },
  "clients": [
    {
      "clientId": "booktracker-app",
      "name": "BookTracker Mobile App",
      "description": "Public client for the mobile app: authorization code + PKCE (S256).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "booktracker://auth/callback",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "booktracker://auth/logout"
      }
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@booktracker.local",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-booktracker",
        "user"
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "testuser2",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser2@booktracker.local",
      "firstName": "Second",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-booktracker",
        "user"
      ]
    }
  ]
}
