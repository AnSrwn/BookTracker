# Stack variables of the Keycloak stack, kept in Portainer. Names only: never put values in this file.

# Set by the deploy workflow on every deploy
IMAGE_TAG=

KC_DATABASE=
KC_DB_USERNAME=
KC_DB_PASSWORD=

# https://auth.<domain>
KC_HOSTNAME=

# https://api.dev.<domain> and https://api.<domain>, without a trailing slash
BOOKTRACKER_DEV_API_URL=
BOOKTRACKER_PROD_API_URL=

# SMTP for verification and password reset mails (implicit TLS, e.g. port 465)
BOOKTRACKER_SMTP_HOST=
BOOKTRACKER_SMTP_PORT=
# Sender address, e.g. booktracker@<domain>; usually also the login
BOOKTRACKER_SMTP_FROM=
BOOKTRACKER_SMTP_USERNAME=
BOOKTRACKER_SMTP_PASSWORD=
