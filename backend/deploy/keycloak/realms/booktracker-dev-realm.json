{
  "realm": "booktracker-dev",
  "enabled": true,
  "displayName": "BookTracker (dev)",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "smtpServer": {
    "host": "${BOOKTRACKER_SMTP_HOST}",
    "port": "${BOOKTRACKER_SMTP_PORT}",
    "from": "${BOOKTRACKER_SMTP_FROM}",
    "fromDisplayName": "BookTracker (dev)",
    "auth": "true",
    "user": "${BOOKTRACKER_SMTP_USERNAME}",
    "password": "${BOOKTRACKER_SMTP_PASSWORD}",
    "ssl": "false",
    "starttls": "true"
  },
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard BookTracker user"
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-booktracker-dev",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "user"
          ],
          "client": {
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-booktracker-dev",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "booktracker-app",
      "name": "BookTracker Mobile App",
      "description": "Public client for the mobile app and Swagger UI: authorization code + PKCE (S256).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "booktracker://auth/callback",
        "${BOOKTRACKER_DEV_API_URL}/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "${BOOKTRACKER_DEV_API_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "booktracker://auth/logout"
      }
    }
  ]
}
