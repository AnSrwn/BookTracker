# Stack variables of one backend environment, kept in Portainer. Names only: never put values in this file.
# Every value is set per environment (dev and prod differ in each line except the user agent and the Google key).

# Set by the deploy workflow on every deploy
IMAGE_TAG=

# dev or prod: part of the container name the reverse proxy forwards to
BOOKTRACKER_ENV=

DATABASE=
DB_USERNAME=
DB_PASSWORD=

# https://auth.<domain>/realms/<realm>
BOOKTRACKER_ISSUER_URI=
# http://booktracker-keycloak:8080/realms/<realm>/protocol/openid-connect/certs
BOOKTRACKER_JWK_SET_URI=

# Contact for Open Library's API policy, e.g. BookTracker/0.1 (+<monitored address>)
BOOKTRACKER_BOOKDATA_USER_AGENT=

# At least 32 bytes, e.g. `openssl rand -base64 48`
BOOKTRACKER_CATALOG_HIT_ID_SECRET=

BOOKTRACKER_GOOGLE_BOOKS_ENABLED=true
BOOKTRACKER_GOOGLE_BOOKS_API_KEY=

# Extra password in front of Swagger UI
BOOKTRACKER_API_DOCS_USERNAME=
BOOKTRACKER_API_DOCS_PASSWORD=
